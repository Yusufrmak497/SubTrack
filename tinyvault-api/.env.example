# TinyVault API environment template (Week 11)

# Railway will provide this automatically when Postgres is attached.
# Keep local sqlite by not setting DATABASE_URL.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT signing key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-strong-secret

# Optional token lifetime (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Frontend URL for CORS in production
FRONTEND_URL=https://your-frontend.vercel.app

# Optional extra CORS origins (comma-separated)
CORS_ORIGINS=https://your-preview.vercel.app
